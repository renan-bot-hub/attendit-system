PORT=5000
NODE_ENV=development
# MongoDB connection string
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/attend_it?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/attend_it
JWT_SECRET=replace_me_with_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Production safety switches
ALLOW_BOOTSTRAP_ADMIN=false
ALLOW_PUBLIC_STAFF_SIGNUP=false
ALLOW_PARENT_SELF_REGISTRATION=true
ALLOW_UNLINKED_PARENT_REGISTRATION=false
ALLOW_DESTRUCTIVE_SEED=false
SEED_PASSWORD=

# Optional, used only by npm run db:merge:dry / npm run db:merge
MOBILE_SOURCE_DB=attendit_db
UNIFIED_TARGET_DB=attend_it

# Optional, used by npm run mobile:import:dry / npm run mobile:import
MOBILE_EXPORT_DIR=../attendit-db-import/attendit_db
