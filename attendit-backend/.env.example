# Backend env vars
# Copy this file to .env for local dev. On Render, paste each value into the service's "Environment" tab.

# Port (Render injects this automatically — leave 5000 for local dev)
PORT=5000

# MongoDB connection string
# Local:  mongodb://localhost:27017/attend_it
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/attend_it?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/attend_it

# JWT signing secret — generate a strong random string for production.
# Quick way: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Comma-separated list of allowed frontend origins (CORS)
# Local:       http://localhost:5173
# Production:  https://attendit-web.onrender.com
# Both:        http://localhost:5173,https://attendit-web.onrender.com
CLIENT_ORIGIN=http://localhost:5173
